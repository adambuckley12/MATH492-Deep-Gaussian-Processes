	year = {2022},
	note = {\_eprint: https://onlinelibrary.wiley.com/doi/pdf/10.1002/cpe.6692},
	keywords = {credit risk prediction, feedforward neural networks, Gaussian processes, machine learning, multilayer perceptron, stochastic signal processing},
	pages = {e6692},
	file = {Full Text PDF:/Users/adam/Zotero/storage/ST5D7KD4/Mahajan et al. - 2022 - A Gaussian process-based approach toward credit risk modeling using stationary activations.pdf:application/pdf;Snapshot:/Users/adam/Zotero/storage/27B3UT6K/cpe.html:text/html},
