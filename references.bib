@inproceedings{wilson_deep_2016,
	title = {Deep {Kernel} {Learning}},
	booktitle = {Proceedings of the 19th {International} {Conference} on {Artificial} {Intelligence} and {Statistics}},
	volume = {51},
	publisher = {PMLR},
	author = {Wilson, Andrew Gordon and Hu, Zhiting and Salakhutdinov, Ruslan and Xing, Eric P.},
	year = {2016},
	pages = {370--378},
	url = {http://arxiv.org/abs/1511.02222},
	abstract = {We introduce scalable deep kernels, which combine the structural properties of deep learning architectures with the non-parametric flexibility of kernel methods. Specifically, we transform the inputs of a spectral mixture base kernel with a deep architecture, using local kernel interpolation, inducing points, and structure exploiting (Kronecker and Toeplitz) algebra for a scalable kernel representation. These deep kernels can learn invariances and extract features across all layers of a deep architecture, through millions of inducing points.},
}

@inproceedings{ober_promises_2021,
	title = {The {Promises} and {Pitfalls} of {Deep} {Kernel} {Learning}},
	booktitle = {Proceedings of the {Thirty}-{Seventh} {Conference} on {Uncertainty} in {Artificial} {Intelligence}},
	volume = {161},
	publisher = {PMLR},
	author = {Ober, Sebastian W. and Rasmussen, Carl E. and van der Wilk, Mark},
	year = {2021},
	pages = {1206--1216},
	abstract = {Deep kernel learning (DKL) combines the structural properties of deep learning with the flexibility of kernel methods. We analyze DKL and find that a related model produces reasonable predictive uncertainties while avoiding common issues with DKL due to decoupling of the model's lengthscale from the architecture.},
}

@article{calandra_manifold_2016,
	title = {Manifold {Gaussian} {Processes} for {Regression}},
	journal = {International Joint Conference on Neural Networks (IJCNN)},
	author = {Calandra, Roberto and Peters, Jan and Rasmussen, Carl Edward and Deisenroth, Marc Peter},
	year = {2016},
	pages = {3338--3345},
	publisher = {IEEE},
	doi = {10.1109/IJCNN.2016.7727626},
	abstract = {Off-the-shelf Gaussian process (GP) covariance functions encode smoothness assumptions on the structure of the function to be modeled. To model complex functions, rather than combining standard covariances by addition and multiplication, we propose Manifold Gaussian Processes, where we use a neural network to learn a feature space, i.e., a space where standard covariance functions can be applied. We learn the feature space and the GP simultaneously in a fully Bayesian fashion.},
}

