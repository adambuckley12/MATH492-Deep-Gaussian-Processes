	note = {arXiv:1903.07320 [stat]},
	keywords = {Computer Science - Machine Learning, Statistics - Machine Learning},
	file = {PDF:/Users/adam/Zotero/storage/4NENUUHX/Cutajar et al. - 2019 - Deep Gaussian Processes for Multi-fidelity Modeling.pdf:application/pdf},
}

@misc{kumar_deep_2018,
	title = {Deep {Gaussian} {Processes} with {Convolutional} {Kernels}},
	url = {http://arxiv.org/abs/1806.01655},
	doi = {10.48550/arXiv.1806.01655},
	abstract = {Deep Gaussian processes (DGPs) provide a Bayesian non-parametric alternative to standard parametric deep learning models. A DGP is formed by stacking multiple GPs resulting in a well-regularized composition of functions. The Bayesian framework that equips the model with attractive properties, such as implicit capacity control and predictive uncertainty, makes it at the same time challenging to combine with a convolutional structure. This has hindered the application of DGPs in computer vision tasks, an area where deep parametric models (i.e. CNNs) have made breakthroughs. Standard kernels used in DGPs such as radial basis functions (RBFs) are insuﬃcient for handling pixel variability in raw images. In this paper, we build on the recent convolutional GP to develop Convolutional DGP (CDGP) models which eﬀectively capture image level features through the use of convolution kernels, therefore opening up the way for applying DGPs to computer vision tasks. Our model learns local spatial inﬂuence and outperforms strong GP based baselines on multi-class image classiﬁcation. We also consider various constructions of convolution kernel over the image patches, analyze the computational trade-oﬀs and provide an eﬃcient framework for convolutional DGP models. The experimental results on image data such as MNIST, rectangles-image, CIFAR10 and Caltech101 demonstrate the effectiveness of the proposed approaches.},
	language = {en},
	urldate = {2026-02-01},
	publisher = {arXiv},
	author = {Kumar, Vinayak and Singh, Vaibhav and Srijith, P. K. and Damianou, Andreas},
	month = jun,
	year = {2018},
